<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.yt.dlp.GUI.FXMLGuiController">
   <children>
      <Label layoutX="256.0" layoutY="104.0" prefHeight="32.0" prefWidth="80.0" text="Video link:" textAlignment="CENTER">
         <font>
            <Font size="16.0" />
         </font></Label>
      <TextField fx:id="videoUrlTextfield" layoutX="44.0" layoutY="136.0" prefHeight="11.0" prefWidth="512.0" />
      <ChoiceBox fx:id="videoFileType" layoutX="211.0" layoutY="174.0" prefHeight="26.0" prefWidth="74.0" />
      <Button fx:id="downloadButton" layoutX="300.0" layoutY="174.0" mnemonicParsing="false" onAction="#buttonActionHandler" text="Download" />
      <Label fx:id="status" layoutX="270.0" layoutY="239.0" prefHeight="32.0" prefWidth="52.0" textAlignment="CENTER">
         <font>
            <Font size="16.0" />
         </font>
      </Label>
      <ProgressBar fx:id="downloadProgressBar" layoutX="40.0" layoutY="280.0" prefHeight="20.0" prefWidth="512.0" progress="0.0" />
